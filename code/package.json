    "ch02": "tsx src/demos/ch02-first-call.ts",
    "ch07": "tsx src/demos/ch07-tool-loop.ts",
    "ch08": "tsx src/demos/ch08-agent.ts",
    "ch12": "tsx src/demos/ch12-mini-search.ts",
    "ingest": "tsx src/demos/ch13-ingest.ts",
    "ch13": "tsx src/demos/ch13-rag.ts",
    "eval:rag": "npx promptfoo@0.125 eval -c fixtures/promptfooconfig-rag.yaml"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.41.0",
    "@langchain/textsplitters": "^1.0.2",
    "apache-arrow": "^21.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "marked": "^18.2.0",
    "minisearch": "^7.2.0",
    "openai": "^7.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }

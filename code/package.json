{
  "name": "ai-course-code",
  "private": true,
  "type": "module",
  "description": "《AI 开发完整教程（纯 TypeScript 版）》配套代码：各章核心模块的可运行参考实现 + 离线测试",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",

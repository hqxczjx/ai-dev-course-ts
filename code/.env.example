# 复制为 .env 后填写；.env 不要提交到 Git。
# 离线测试（pnpm check）不需要任何 key；只有 pnpm ch02/ch07/ch08 等真实调用才需要。
API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
MODEL_CHEAP=deepseek-flash
MODEL_GOOD=deepseek-v4-pro

# ── 第 12–13 章 RAG（可选）：DeepSeek 没有 embedding 接口，需要单独的 key ──
# 硅基流动的 BAAI/bge-m3 与 bge-reranker-v2-m3 免费（2026-11 复核）
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH=10
RERANK_PROVIDER=siliconflow
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# LANCEDB_PATH=./data/lancedb
# RAG_DATA_DIR=./data/kb

# ── pnpm eval:rag（promptfoo 评分模型）：DeepSeek 的 key，可与 API_KEY 相同 ──
DEEPSEEK_API_KEY=
